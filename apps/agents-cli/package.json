{
  "name": "agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agents": "dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "dev": "node --loader ts-node/esm src/cli/index.ts",
    "dev:watch": "node --watch --watch-path=src --watch-path=skills --loader ts-node/esm src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "echo \"Tests are not included in this open-source distribution.\"",
    "trace:migrate": "node --loader ts-node/esm src/runtime/trace-migrate.ts",
    "diagnose:llm": "node scripts/check-llm-connectivity.mjs",
    "validate:agent-defs": "node scripts/validate-agent-defs.mjs",
    "watch": "node scripts/watch.mjs",
    "start": "node dist/cli/index.js",
    "postbuild": "node scripts/sync-global-config.mjs",
    "postinstall": "node scripts/sync-global-config.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.98",
    "commander": "^12.1.0",
    "redis": "^4.7.0",
    "undici": "^7.16.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
