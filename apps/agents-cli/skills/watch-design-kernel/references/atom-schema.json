{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watch Design Knowledge Domain",
  "type": "object",
  "required": ["domain", "atoms"],
  "properties": {
    "domain": {"type": "string"},
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom_id", "title", "review_status", "claim", "activation", "decision_targets", "move", "evidence_refs", "validation_needs"],
        "properties": {
          "atom_id": {"type": "string", "pattern": "^watch-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 2},
          "review_status": {"enum": ["draft", "approved", "retired"]},
          "claim": {"type": "string", "minLength": 12},
          "activation": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "avoid_when": {"type": "array", "items": {"type": "string"}},
          "decision_targets": {"type": "array", "minItems": 1, "items": {"enum": ["architecture", "wearability", "experience", "cmf", "signature", "image_evidence"]}},
          "move": {
            "type": "object",
            "required": ["action", "why", "visible_cues", "limits", "tradeoffs"],
            "properties": {
              "action": {"type": "string"}, "why": {"type": "string"},
              "visible_cues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "tradeoffs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validation_needs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
