{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phone-design-judgment.schema.json",
  "title": "India-oriented Phone Exterior Design Judgment 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_brief",
    "functional_form",
    "cultural_expression",
    "concept_identity",
    "presentation"
  ],
  "properties": {
    "design_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_class", "fixed_requirements", "open_exterior_decisions"],
      "properties": {
        "product_class": {
          "enum": ["entry", "mainstream", "upper-mid", "flagship"]
        },
        "fixed_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "open_exterior_decisions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "functional_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attention_share",
        "silhouette_proportion",
        "corner_chamfer_grip",
        "front_frame_controls",
        "camera_architecture",
        "rear_surface",
        "exterior_consequences"
      ],
      "properties": {
        "attention_share": {
          "const": "about 80% unless the brief overrides it"
        },
        "silhouette_proportion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body_aspect", "visual_thickness", "volume_character"],
          "properties": {
            "body_aspect": {"type": "string", "minLength": 1},
            "visual_thickness": {"type": "string", "minLength": 1},
            "volume_character": {"type": "string", "minLength": 1}
          }
        },
        "corner_chamfer_grip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corner_family", "front_edge", "frame_profile", "rear_transition", "grip_character", "propagated_relationship"],
          "properties": {
            "corner_family": {"type": "string", "minLength": 1},
            "front_edge": {"type": "string", "minLength": 1},
            "frame_profile": {"type": "string", "minLength": 1},
            "rear_transition": {"type": "string", "minLength": 1},
            "grip_character": {"type": "string", "minLength": 1},
            "propagated_relationship": {"type": "string", "minLength": 1}
          }
        },
        "front_frame_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_boundary", "bezel_logic", "front_camera", "controls", "openings_and_seams"],
          "properties": {
            "display_boundary": {"type": "string", "minLength": 1},
            "bezel_logic": {"type": "string", "minLength": 1},
            "front_camera": {"type": "string", "minLength": 1},
            "controls": {"type": "string", "minLength": 1},
            "openings_and_seams": {"type": "string", "minLength": 1}
          }
        },
        "camera_architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supplied_hardware", "visual_role", "arrangement", "elevation", "protection", "chassis_relationship"],
          "properties": {
            "supplied_hardware": {"type": "string", "minLength": 1},
            "visual_role": {"enum": ["primary", "supporting", "quiet"]},
            "arrangement": {"type": "string", "minLength": 1},
            "elevation": {"type": "string", "minLength": 1},
            "protection": {"type": "string", "minLength": 1},
            "chassis_relationship": {"type": "string", "minLength": 1}
          }
        },
        "rear_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface_architecture", "material_zones", "reflectivity_hierarchy"],
          "properties": {
            "surface_architecture": {"type": "string", "minLength": 1},
            "material_zones": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {"type": "string", "minLength": 1}
            },
            "reflectivity_hierarchy": {"type": "string", "minLength": 1}
          }
        },
        "exterior_consequences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supplied_requirement", "visible_consequence", "claim_limit"],
            "properties": {
              "supplied_requirement": {"type": "string", "minLength": 1},
              "visible_consequence": {"type": "string", "minLength": 1},
              "claim_limit": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "cultural_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attention_share",
        "source_family",
        "abstracted_relationship",
        "primary_carrier",
        "supporting_carrier",
        "camera_clearance",
        "integration_limit"
      ],
      "properties": {
        "attention_share": {
          "const": "about 20% unless the brief overrides it"
        },
        "source_family": {
          "enum": ["material-craft", "architectural-relationship", "regional-nature", "festival-atmosphere", "brief-supplied"]
        },
        "abstracted_relationship": {"type": "string", "minLength": 1},
        "primary_carrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "expression"],
          "properties": {
            "zone": {"enum": ["rear-surface", "material-process", "pattern-field", "colour-behaviour", "finish-field", "local-edge-detail", "brief-supplied"]},
            "expression": {"type": "string", "minLength": 1}
          }
        },
        "supporting_carrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "expression"],
          "properties": {
            "zone": {"enum": ["control-detail", "fine-boundary", "micro-texture", "local-chamfer", "subtle-colour-accent", "none", "brief-supplied"]},
            "expression": {"type": "string"}
          }
        },
        "camera_clearance": {
          "const": "camera position and optical hierarchy resolve first; cultural fields terminate, route around, or support them without placing lenses ambiguously on a decorative boundary"
        },
        "integration_limit": {
          "const": "cultural expression does not determine major body volume, camera position, or primary camera-island topology unless the brief explicitly grants that role"
        }
      }
    },
    "concept_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exterior_thesis", "leading_departure", "visible_decisions", "family_genes"],
      "properties": {
        "exterior_thesis": {"type": "string", "minLength": 1},
        "leading_departure": {"type": "string", "minLength": 1},
        "visible_decisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "family_genes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dual_view", "atmosphere"],
      "properties": {
        "dual_view": {
          "const": "exactly two consistent views of one bare phone and one colourway: rear or rear-three-quarter primary and front secondary"
        },
        "atmosphere": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_continuity", "colour_field", "light_shadow_haze", "subordination"],
          "properties": {
            "source_continuity": {"type": "string", "minLength": 1},
            "colour_field": {"type": "string", "minLength": 1},
            "light_shadow_haze": {"type": "string", "minLength": 1},
            "subordination": {
              "const": "the atmosphere supports product presentation and cannot supply cultural identity absent from the phone"
            }
          }
        }
      }
    }
  }
}
