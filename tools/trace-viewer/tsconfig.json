{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@trace-events": ["../../apps/agents-cli/src/runtime/trace-events.ts"]
    }
  },
  "include": ["server/**/*.ts", "web/src/**/*.ts", "web/src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
